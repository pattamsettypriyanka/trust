# TrustVault Environment Configuration

# Server Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=trustvault-dev

# Emulator configuration (Local dev and testing)
# Leave unset or set to true for automated test/in-memory/emulator mode
USE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8088
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Client Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=demo-api-key-for-dev
VITE_FIREBASE_AUTH_DOMAIN=trustvault-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trustvault-dev
VITE_USE_EMULATOR=true
